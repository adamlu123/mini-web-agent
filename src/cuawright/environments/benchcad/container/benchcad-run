#!/usr/bin/env python3
from __future__ import annotations

import argparse
from pathlib import Path

from benchcad_core.scoring.exec_cq import execute_cq_to_step, extract_code


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("prediction")
    parser.add_argument("--step", default="/workspace/candidate.step")
    parser.add_argument("--timeout", type=int, default=300)
    args = parser.parse_args()
    raw = Path(args.prediction).read_text(encoding="utf-8", errors="replace")
    code = extract_code(raw)
    if not code:
        raise SystemExit("No parseable CadQuery code")
    execute_cq_to_step(code, Path(args.step), timeout=args.timeout)
    print(args.step)


if __name__ == "__main__":
    main()
